# --- App ---------------------------------------------------------------------
# URL publica de ESTE backend (la usa el share link cuando no publicas a Webflow)
PUBLIC_BASE_URL=http://localhost:8000

# Origenes permitidos por CORS. En produccion poné el dominio de Webflow:
#   CORS_ORIGINS=https://tu-sitio.webflow.io,https://tudominio.com
CORS_ORIGINS=*

# Cuantos audits en paralelo. Slither come CPU: 2 esta bien en un droplet chico.
MAX_WORKERS=2
DB_PATH=/srv/data/smartcheck.db

# --- Analisis ----------------------------------------------------------------
SLITHER_TIMEOUT=120
SOLC_TIMEOUT=180
DEFAULT_SOLC=0.8.26
MAX_SOURCE_BYTES=1000000
DEFAULT_NETWORK=sepolia

# --- Fuentes de codigo verificado -------------------------------------------
# Sourcify es gratis y sin key. Etherscan v2 es el fallback y SI requiere key.
# Sin key el fallback se desactiva solo (Sourcify sigue funcionando).
ETHERSCAN_API_KEY=

# --- Publisher (Webflow) -----------------------------------------------------
# none -> el share link lo sirve este backend (default, arranca sin config)
# rest -> Webflow Data API v2 directo. Solo Python, crea el item ya en live.
# mcp  -> Webflow MCP server via stdio. Protocolo MCP real (categoria hackathon).
#         Requiere Node >= 22.3 en la imagen: descomentá el bloque del Dockerfile.
PUBLISHER=none

# Token del API Playground de Webflow. Lo usan rest y mcp por igual.
WEBFLOW_TOKEN=
WEBFLOW_SITE_ID=
WEBFLOW_COLLECTION_ID=
# Dominio publicado, sin barra final. Ej: https://smartcheck.webflow.io
WEBFLOW_SITE_DOMAIN=
WEBFLOW_ITEM_SLUG_PREFIX=audit
